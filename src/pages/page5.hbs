<!doctype html>

<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#123e34"><title>Trix Scorekeeper</title>
<style>
:root{font:16px/1.5 system-ui,sans-serif;color:#19372f;background:#f7f5ed;--green:#123e34;--line:#d8d8c9;--red:#9e3848}*{box-sizing:border-box}body{margin:0}.wrap{max-width:850px;margin:auto;padding:0 18px}header{background:var(--green);color:#faf5dd;padding:24px 0;border-bottom:4px solid #bd9b58}header .wrap,.row{display:flex;align-items:center;justify-content:space-between;gap:12px}h1,h2,h3{font-family:Georgia,serif;line-height:1.15;margin:0}h1{font-size:clamp(30px,5vw,49px)}header span{font:32px Georgia;color:#dcc696}main{padding-bottom:40px!important}section,details{background:#fffef9;border:1px solid var(--line);border-radius:14px;padding:clamp(15px,3vw,28px);margin:16px 0}h2{font-size:28px}p{margin:9px 0 16px}.sub,small{color:#516559}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.scores{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:15px 0}.score{border-top:2px solid #bd9b58;padding:8px;background:#f4f4eb;overflow-wrap:anywhere}.score b{display:block;font:30px Georgia}.team{font-weight:650}label{display:grid;gap:4px;font-size:.92rem;font-weight:600;min-width:0}input,select,button{font:inherit;max-width:100%}input,select{width:100%;padding:10px;background:white;color:#19372f;border:1px solid #a4b2a9;border-radius:7px;min-height:45px}button,summary{cursor:pointer}button{background:var(--green);color:white;border:0;border-radius:7px;padding:11px 16px;font-weight:650}button.alt{background:#e8eee7;color:var(--green)}button:focus-visible,summary:focus-visible{outline:3px solid #aa8242;outline-offset:2px}fieldset{border:1px solid var(--line);border-radius:8px;margin:14px 0;padding:12px}legend{font-weight:bold}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.alert{color:#922c39;font-weight:600}.alert:empty{display:none}summary{font-weight:700}.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;margin-top:12px;font-size:.9rem}th,td{padding:8px;border-bottom:1px solid var(--line);text-align:right}th:first-child,td:first-child{text-align:left}th{overflow-wrap:anywhere}td button{padding:6px 10px}.contract{margin:15px 0}#preview{font-size:.94rem}.red{color:var(--red)}[hidden]{display:none!important}@media(max-width:550px){.scores{grid-template-columns:1fr 1fr}.row{flex-wrap:wrap}header{padding:17px 0}.grid{gap:8px}fieldset .grid{grid-template-columns:1fr}th,td{padding:6px}.wrap{padding:0 12px}}
</style>
</head>
<body>
 <!--<header><div class="wrap"><h1>Trix Scorekeeper</h1><span lang="ar">تريكس</span></div></header> --> 
 
 <header>
    <div class="masthead">
      <div>
        <h1>MORE Score Tracker</h1>
        <p class="credit">Developed by Ammar A</p>
      </div>
      <span class="flag" role="img" aria-label="Palestinian flag"></span>
    </div>
  </header>
 
 <main class="wrap"><p id="storage" role="status"></p><div id="app"><section><h2>Open the scorekeeper</h2><p>Download this HTML file and open it in your browser to use the interactive scorecard.</p></section></div>
<details><summary>Scoring rules</summary><p>Each player rules one kingdom and chooses all five contracts once. Play follows the seat order you enter, starting with the chosen king. Highest score wins. Partners sit opposite and combine their scores.</p>
<ul><li>King of Hearts −75. Each queen −25.</li><li>Each diamond −10. Each trick −15.</li><li>Trix finish order earns +200, +150, +100, +50.</li><li>For an exposed (doubled) king or queen, charge the taker twice and credit the original holder the base value. If the holder takes their own card, credit whoever led that trick. When the holder also led it, the net charge is the ordinary penalty.</li></ul><a href="https://www.pagat.com/compendium/trex.html">Trix rules at Pagat</a></details></main>
<script>
'use strict';
const app=document.getElementById('app');
const key='trix-scorekeeper-classic-v1';
const contracts={king:'King of Hearts · شيخ الكبة',queens:'Queens · البنات',diamonds:'Diamonds · الديناري',tricks:'Tricks · اللطوش',trix:'Trix · تريكس'};
const cards={king:['K♥'],queens:['Q♥','Q♦','Q♣','Q♠']};
const places=['1st · +200','2nd · +150','3rd · +100','4th · +50'];
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const signed=n=>n>0?'+'+n:String(n);
const by=id=>document.getElementById(id);
const seat=n=>Number.isInteger(n)&&n>=0&&n<4;
function requireValue(test,message){if(!test)throw Error(message)}
function score(type,data){
 const pts=[0,0,0,0];
 if(cards[type]){
  requireValue(data.length===cards[type].length,'Record every card.');
  data.forEach(({take,holder,lead})=>{
   requireValue(seat(take),'Choose who took each card.');
   requireValue(holder===null||seat(holder),'Choose who doubled the card.');
   const cost=type==='king'?75:25;pts[take]-=cost;
   if(holder!==null){
    const credit=holder===take?lead:holder;
    requireValue(seat(credit),'Choose who led the trick with the self-captured card.');
    pts[take]-=cost;pts[credit]+=cost;
   }
  });
 }else if(type==='trix'){
  requireValue(data.length===4&&data.every(seat)&&new Set(data).size===4,'Choose a different player for each finishing place.');
  data.forEach((player,i)=>pts[player]=200-i*50);
 }else{
  requireValue(['diamonds','tricks'].includes(type),'Unknown contract.');
  requireValue(data.length===4&&data.every(n=>Number.isInteger(n)&&n>=0&&n<=13)&&data.reduce((a,b)=>a+b,0)===13,'The four counts must be whole numbers adding up to 13.');
  data.forEach((n,i)=>pts[i]=-n*(type==='diamonds'?10:15));
 }
 return pts;
}
function valid(g){
 requireValue(g&&Array.isArray(g.names)&&g.names.length===4&&g.names.every(n=>typeof n==='string'&&n.trim()&&n.length<=30)&&seat(g.first)&&typeof g.team==='boolean'&&Array.isArray(g.rounds)&&g.rounds.length<=20,'Invalid game');
 let used=new Set();
 g.rounds.forEach(({type,data},i)=>{if(i%5===0)used=new Set();requireValue(!used.has(type),'Repeated contract');used.add(type);score(type,data)});
 return g;
}
let game=null,editing=-1,loadFailed=false;
function warn(msg){by('storage').textContent=msg}
let stored=null;
try{stored=localStorage.getItem(key)}catch{warn('Storage is unavailable. You can play while this tab stays open.')}
if(stored){
 try{game=valid(JSON.parse(stored))}catch{loadFailed=true;warn('The saved game could not be opened. You can start a fresh game below.')}
}
function save(){try{localStorage.setItem(key,JSON.stringify(game));warn('')}catch{warn('This browser could not save your game. Keep this tab open to retain your scores.')}}
function setup(){
 app.innerHTML='<section><h2>Set up your table</h2><p class="sub">Enter names in kingdom order, or leave them blank to use Player 1–4.</p><form id="setup"><div class="grid">'+Array.from({length:4},(_,i)=>'<label>Seat '+(i+1)+'<input id="n'+i+'" maxlength="30" placeholder="Player '+(i+1)+'"></label>').join('')+'</div><p></p><div class="grid"><label>First king<select id="first"></select></label><label>Scoring<select id="mode"><option>Individual</option><option>Partners · seats 1+3 vs 2+4</option></select></label></div><div class="actions"><button type="button" id="start">Start game</button></div><p class="alert" id="err" role="alert"></p></form></section>';
 const names=()=>[0,1,2,3].map(i=>by('n'+i).value.trim()||'Player '+(i+1));
 function update(){const prev=by('first').value||'0';by('first').innerHTML=names().map((n,i)=>'<option value="'+i+'">'+esc(n||'Seat '+(i+1))+'</option>').join('');by('first').value=prev}
 update();by('setup').oninput=e=>{if(e.target.tagName==='INPUT')update()};
 const start=e=>{e.preventDefault();const list=names();if(list.some(n=>!n)||new Set(list.map(n=>n.toLowerCase())).size!==4){by('err').textContent='Give each seat a distinct name or nickname.';return}
 if(loadFailed&&!by('replaceSaved').checked){by('err').textContent='Confirm below to replace the unreadable saved game.';return}
 game={names:list,first:Number(by('first').value),team:by('mode').selectedIndex===1,rounds:[]};loadFailed=false;save();render()};
 if(loadFailed)by('setup').insertAdjacentHTML('beforeend','<label><span><input style="width:auto;min-height:0" type="checkbox" id="replaceSaved"> Replace the unreadable saved game</span></label>');
 by('start').onclick=start;
 by('setup').onsubmit=start;
}
function choose(id,label,value,blank='Choose player'){
 const options=game.names.map((n,i)=>'<option value="'+i+'" '+(value===i?'selected':'')+'>'+esc(n)+'</option>').join('');
 return '<label>'+label+'<select id="'+id+'"><option value="">'+blank+'</option>'+options+'</select></label>';
}
function form(type,data=[]){
 if(cards[type])return cards[type].map((card,i)=>{
  const d=data[i]||{};return '<fieldset><legend class="'+(/[♥♦]/.test(card)?'red':'')+'">'+card+'</legend><div class="grid">'+choose('t'+i,'Taken by',d.take)+choose('h'+i,'Doubled by',d.holder,'Not doubled')+'<div id="ld'+i+'">'+choose('l'+i,'Trick led by',d.lead)+'</div></div></fieldset>';
 }).join('');
 if(type==='trix')return '<div class="grid">'+places.map((p,i)=>choose('v'+i,p,data[i])).join('')+'</div>';
 return '<p class="sub">Enter the number of '+type+' each player took (13 total).</p><div class="grid">'+game.names.map((n,i)=>'<label>'+esc(n)+'<input type="number" inputmode="numeric" min="0" max="13" step="1" id="v'+i+'" value="'+(data[i]??0)+'"></label>').join('')+'</div>';
}
const numberOf=id=>by(id).value===''?null:Number(by(id).value);
function readForm(type){
 if(cards[type])return cards[type].map((_,i)=>{const take=numberOf('t'+i),holder=numberOf('h'+i);const self=holder!==null&&take===holder;by('ld'+i).hidden=!self;return {take,holder,lead:self?numberOf('l'+i):null}});
 return [0,1,2,3].map(i=>numberOf('v'+i));
}
const kingAt=index=>(game.first+Math.floor(index/5))%4;
function render(){
 if(!game){setup();return}
 const rounds=game.rounds,n=rounds.length,done=n===20,ix=editing<0?n:editing,tot=[0,0,0,0];
 const scores=rounds.map(r=>score(r.type,r.data));scores.forEach(p=>p.forEach((v,i)=>tot[i]+=v));
 const names=game.names.map(esc),teams=[tot[0]+tot[2],tot[1]+tot[3]],pairs=[names[0]+' &amp; '+names[2],names[1]+' &amp; '+names[3]];
 const values=game.team?teams:tot,labels=game.team?pairs:names,winners=labels.filter((_,i)=>values[i]===Math.max(...values));
 app.innerHTML='<section><div class="row"><h2>'+(done?'Final scores':'Scoreboard')+'</h2><span>'+n+' / 20 hands</span></div><div class="scores">'+names.map((name,i)=>'<div class="score">'+name+'<b>'+signed(tot[i])+'</b></div>').join('')+'</div>'+(game.team?'<p class="team">'+pairs.map((p,i)=>p+' ('+signed(teams[i])+')').join(' · ')+'</p>':'')+(done?'<h3>'+(winners.length===1?'Winner · ':'Tie · ')+winners.join(' / ')+'</h3>':'')+'</section>';
 if(!done||editing>=0){
  const available=Object.keys(contracts).filter(t=>!rounds.slice(ix-ix%5,ix).some(r=>r.type===t));
  app.insertAdjacentHTML('beforeend','<section id="entry"><div class="row"><h2>'+names[kingAt(ix)]+'’s kingdom</h2><span>Kingdom '+(Math.floor(ix/5)+1)+' of 4</span></div><p class="sub">'+(editing>=0?'Editing':'Recording')+' hand '+(ix+1)+'</p><label class="contract">Contract<select id="type" '+(editing>=0?'disabled':'')+'>'+ (editing>=0?[rounds[ix].type]:available).map(t=>'<option value="'+t+'">'+contracts[t]+'</option>').join('')+'</select></label><form id="hand"><div id="fields"></div><p id="preview" aria-live="polite"></p><p class="alert" id="err" role="alert"></p><div class="actions"><button type="button" id="record">' +(editing>=0?'Save correction':'Record hand')+'</button>'+(editing>=0?'<button class="alt" type="button" id="cancel">Cancel</button>':'')+'</div></form></section>');
  function preview(){const t=by('type').value,d=readForm(t);by('err').textContent='';try{const pts=score(t,d);by('preview').textContent=game.names.map((s,i)=>s+' '+signed(pts[i])).join(' · ')}catch{by('preview').textContent=['diamonds','tricks'].includes(t)?d.reduce((a,b)=>a+(b||0),0)+' / 13 assigned':''}}
  function fields(){by('fields').innerHTML=form(by('type').value,editing>=0?rounds[ix].data:[]);preview()}
  fields();by('type').onchange=fields;by('hand').oninput=preview;
  const record=e=>{e.preventDefault();const type=by('type').value,data=readForm(type);try{score(type,data)}catch(error){by('err').textContent=error.message;return}
   rounds[ix]={type,data};editing=-1;save();render()};
  by('record').onclick=record;by('hand').onsubmit=record;
  if(editing>=0)by('cancel').onclick=()=>{editing=-1;render()};
 }
 app.insertAdjacentHTML('beforeend','<details id="history"><summary>Scorecard · '+n+' recorded hands</summary>'+(n?'<div class="scroll"><table><thead><tr><th>Hand / contract</th>'+names.map(n=>'<th>'+n+'</th>').join('')+'<th>Edit</th></tr></thead><tbody>'+rounds.map((r,i)=>'<tr><td>'+ (i+1)+'. '+contracts[r.type].split(' · ')[0]+'<br><small>'+names[kingAt(i)]+'</small></td>'+scores[i].map(v=>'<td>'+signed(v)+'</td>').join('')+'<td><button class="alt" data-edit="'+i+'" aria-label="Edit hand '+(i+1)+'">Edit</button></td></tr>').reverse().join('')+'</tbody></table></div><div class="actions"><button class="alt" id="undo">Undo last hand</button></div>':'<p>No hands recorded yet.</p>')+'</details><div class="actions"><button class="alt" id="new">New game</button></div>');
 by('history').onclick=e=>{if(e.target.dataset.edit!==undefined){editing=Number(e.target.dataset.edit);render();by('entry').scrollIntoView()}};
 if(n)by('undo').onclick=()=>{if(confirm('Remove hand '+n+' and recalculate the score?')){rounds.pop();editing=-1;save();render()}};
 by('new').onclick=()=>{if(confirm('Start a new table? Starting the next game will replace this scorecard.')){editing=-1;setup();app.insertAdjacentHTML('afterbegin','<button class="alt" id="back">Back to current game</button>');by('back').onclick=render}};
}
render();
</script></body></html>

